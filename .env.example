# ── Django ─────────────────────────────────────────────────────────────────────
# Generate a unique key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to False in production
DJANGO_DEBUG=True

# Space-separated list of allowed host names (no http://)
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# ── CORS ───────────────────────────────────────────────────────────────────────
# Space-separated list of origins (with http(s)://) that may call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173

# ── TomTom (used in later milestones) ──────────────────────────────────────────
TOMTOM_API_KEY=your-tomtom-api-key-here

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Must start with VITE_ to be exposed to the browser bundle
VITE_API_BASE_URL=http://127.0.0.1:8000
